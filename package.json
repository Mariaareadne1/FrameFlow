{
  "name": "frameflow",
  "productName": "FrameFlow",
  "version": "2.3.0",
  "description": "Record your screen. Get a beautiful demo video automatically.",
  "main": "out/main/index.js",
  "type": "module",
  "license": "MIT",
  "author": "FrameFlow contributors",
  "private": true,
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "package": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac",
    "icon": "electron scripts/render-icon.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "lucide-react": "^1.55.0",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
